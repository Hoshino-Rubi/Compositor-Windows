# Translate Apple's block scheduling to synchronous MSVC parallel_for at configure time.
# The upstream C files stay intact and all pixel math comes from the merged revision.
function(compositor_port_pixels name)
  set(source "${CMAKE_CURRENT_SOURCE_DIR}/../Compositor/Rendering/${name}.c")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
  file(READ "${source}" code)
  string(REPLACE "#include <dispatch/dispatch.h>" "#include \"PixelParallel.h\"" code "${code}")
  string(REPLACE "static void in_bands(size_t count, void (^body)(size_t start, size_t end))" "template<class Body> static void in_bands(size_t count, Body body)" code "${code}")
  string(REPLACE "dispatch_apply(bands, DISPATCH_APPLY_AUTO," "pixel_parallel(bands," code "${code}")
  string(REPLACE "^(" "[&](" code "${code}")
  string(REPLACE "__block int failed = 0" "std::atomic<int> failed{0}" code "${code}")
  string(REPLACE "malloc(" "(float *)malloc(" code "${code}")
  string(REPLACE "calloc(" "(double *)calloc(" code "${code}")
  foreach(var alpha copy)
    string(REPLACE "uint8_t *${var} = (float *)malloc(" "uint8_t *${var} = (uint8_t *)malloc(" code "${code}")
  endforeach()
  string(REPLACE "picked = (float *)malloc(" "picked = (int *)malloc(" code "${code}")
  string(REPLACE "(Kernel){" "Kernel{" code "${code}")
  foreach(header AdjustPixels LensPixels DitherPixels)
    string(REPLACE "#include \"${header}.h\"" "extern \"C\" {\n#include \"${header}.h\"\n}" code "${code}")
  endforeach()
  if(code MATCHES "dispatch_|__block|\\^\\(")
    message(FATAL_ERROR "Untranslated Apple scheduler in ${name}")
  endif()
  set(output "${CMAKE_CURRENT_BINARY_DIR}/${name}Windows.cpp")
  set(previous "")
  if(EXISTS "${output}")
    file(READ "${output}" previous)
  endif()
  if(NOT code STREQUAL previous)
    file(WRITE "${output}" "${code}")
  endif()
endfunction()
